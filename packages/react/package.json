{
  "name": "frameable",
  "version": "0.1.0",
  "description": "Headless React hooks for dragging, resizing and rotating frames on a 2D surface",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transformer.css": "./dist/transformer.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "frameable-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "drag",
    "resize",
    "rotate",
    "headless",
    "canvas",
    "transform",
    "moveable",
    "gesture",
    "design-tool"
  ],
  "homepage": "https://github.com/KevinArce98/frameable#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinArce98/frameable.git",
    "directory": "packages/react"
  },
  "author": "Kevin Arias",
  "bugs": {
    "url": "https://github.com/KevinArce98/frameable/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
